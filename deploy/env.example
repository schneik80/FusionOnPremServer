# fusionlocalserver production environment — install as /etc/fusionlocalserver/env,
# owned root:root, mode 0600 (bootstrap.sh sets this up). systemd reads it
# before dropping privileges; the service user never sees the client secret.

# APS app credentials (a confidential client: id + secret).
APS_CLIENT_ID=your-aps-app-client-id
APS_CLIENT_SECRET=your-aps-app-client-secret

# APS region: empty for US, or EMEA / AUS. One region per deployment.
APS_REGION=

# The canonical public origin clients reach the server by. The APS app must
# have <PUBLIC_URL>/api/auth/callback registered as a callback URL — exact
# match, no wildcards.
PUBLIC_URL=https://fls.example.com

# Sign-in whitelist: comma-separated Autodesk emails and/or OIDC subject ids.
# REQUIRED before the server is publicly reachable — without it any Autodesk
# account can sign in, and today every session has admin powers (see
# docs/authentication.md). Also settable as "admin_users" in the service
# user's ~/.config/fusionlocalserver/config.json; this env var overrides it.
FLS_ADMIN_USERS=you@example.com,teammate@example.com
